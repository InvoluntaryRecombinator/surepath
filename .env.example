# Copy to .env (never committed — see .gitignore).
# The ONLY secret in the entire product, needed ONLY for the narrative assistant.
# Everything else — intake, PDF generation, the whole packet — runs with no keys at all.
OPENAI_API_KEY=

# Optional: swap the assistant's model in one line. Defaults to gpt-4.1-mini
# (mid-tier, low latency, native structured outputs). e.g. NARRATIVE_MODEL=gpt-5-mini
# NARRATIVE_MODEL=
